# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Railway: add a PostgreSQL plugin and reference it so the value stays in sync:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eleven_super_kings?schema=public"

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# The PIN you type at /login. Anyone with it gets full read/write access.
ADMIN_PIN="change-me-1234"

# Signs the admin session cookie. Must be at least 16 characters and secret.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
